# lazy-bashrc configuration template
# Copy to config.env (or run ./install.sh) to customize locally.

# Directory containing git repositories / work projects
LAZY_WORK_DIR="/opt/git"

# Color mode for command tracing on stderr: auto | always | never
LAZY_COLOR="auto"

# ANSI color sequence used when printing traced commands (default: bold blue)
LAZY_COLOR_CODE=$'\033[1;34m'

# Indentation added for each nested registered function call
LAZY_INDENT="  "

# Optional prefix before each traced command (e.g. "-> " or "")
LAZY_TRACE_PREFIX=""

# Directory containing symlinks to external project bashrc files (*.bashrc, *.sh, *.bash)
# Leave empty to default to "<repo>/projects".
LAZY_PROJECTS_DIR=""
